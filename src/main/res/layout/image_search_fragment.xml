<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="80dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이미지 검색 설정"
                android:textSize="24sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/part4_permission_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❌ 화면 캡처 권한: 필요함"
                android:textSize="14sp"
                android:textColor="#AA0000"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/part4_request_permission_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📱 화면 캡처 권한 허용하기"
                android:layout_marginBottom="16dp"
                style="@style/Widget.MaterialComponents.Button" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="템플릿 이미지"
                android:textSize="18sp"
                android:textStyle="bold"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

            <TextView
                android:id="@+id/part4_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="템플릿이 없습니다. + 버튼을 눌러 추가하세요."
                android:textSize="14sp"
                android:layout_gravity="center"
                android:padding="16dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/part4_template_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:maxHeight="300dp"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="일치도"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <SeekBar
                    android:id="@+id/part4_threshold_slider"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="80" />

                <TextView
                    android:id="@+id/part4_threshold_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textSize="16sp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="검색 모드"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <Spinner
                android:id="@+id/part4_search_mode_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/part4_tap_on_found"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발견 시 자동 터치"
                android:paddingTop="8dp"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/part4_play_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발견 시 알람 소리"
                android:checked="true"
                android:minHeight="48dp" />

            <CheckBox
                android:id="@+id/part4_vibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="발견 시 진동"
                android:checked="true"
                android:minHeight="48dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이미지 찾으면"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <Spinner
                android:id="@+id/part4_on_found_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/part4_on_found_jump_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="점프할 액션 번호 (예: 5)"
                android:inputType="number"
                android:visibility="gone"
                android:minHeight="48dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="이미지 못찾으면"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <Spinner
                android:id="@+id/part4_on_not_found_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/part4_on_not_found_jump_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="점프할 액션 번호 (예: 3)"
                android:inputType="number"
                android:visibility="gone"
                android:minHeight="48dp"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/part4_test_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 테스트 (현재 화면에서 찾기)"
                android:layout_marginTop="16dp"
                android:minHeight="48dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <Button
                android:id="@+id/part4_add_action_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✅ 액션 추가"
                android:layout_marginTop="8dp"
                android:minHeight="48dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/part4_add_template"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="템플릿 추가"
        android:src="@android:drawable/ic_input_add"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>