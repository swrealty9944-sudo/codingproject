<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/part2_item_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/part2_item_index"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/part2_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOUCH"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/part2_item_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="x=100, y=200"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/part2_item_delay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1000ms"
                    android:textSize="12sp"
                    android:textColor="@android:color/holo_blue_dark"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/part2_item_flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GOTO → 5"
                    android:textSize="12sp"
                    android:textColor="@android:color/holo_orange_dark" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/part2_item_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            android:contentDescription="@string/delete_action" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
